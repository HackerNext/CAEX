        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Generate ICAI Mock Paper",
      "short_name": "Generate Paper",
      "description": "Generate a fresh ICAI-pattern subjective paper or OMR quiz",
      "url": "./index.html?tab=tab-generate",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "View Past Exam History",
      "short_name": "Exam History",
      "description": "Review past evaluated answer sheets and quiz scores",
      "url": "./index.html?tab=tab-history",
      "icons": [
        {
          "src": "./icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
