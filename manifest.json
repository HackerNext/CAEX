  "file_handlers": [
    {
      "action": "./index.html?action=open-file",
      "accept": {
        "application/pdf": [
          ".pdf"
        ],
        "image/jpeg": [
          ".jpg",
          ".jpeg"
        ],
        "image/png": [
          ".png"
        ]
      }
    }
  ],
  "share_target": {
    "action": "./index.html?action=share-target",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url"
    }
  },
  "protocol_handlers": [
    {
      "protocol": "web+icaiexaminer",
      "url": "./index.html?paper=%s"
    }
  ]
